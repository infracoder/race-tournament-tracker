{
  "name": "mariokart",
  "version": "1.0.0",
  "description": "Mario Kart Tournament Tracker - 9 Player Championship",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:reset": "node scripts/reset-db.js",
    "test": "node --test lib/*.test.js test/*.test.js",
    "test:schedule": "node lib/schedule-generator.test.js",
    "test:browser": "playwright test",
    "mdns:start": "bash scripts/advertise-mdns.sh",
    "mdns:stop": "bash scripts/stop-mdns.sh",
    "docker:up": "docker compose up -d && npm run mdns:start",
    "docker:down": "npm run mdns:stop && docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "nodemon": "^3.1.10"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
