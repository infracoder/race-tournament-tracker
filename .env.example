# Mario Kart Tournament Configuration

# Server Port (default: 3000)
PORT=3000

# Organizer PIN (CHANGE THIS!)
ORGANIZER_PIN=1234

# Database File Location (optional)
# DB_FILE=./tournament.db

# Players Per Race (2 or 4)
# Choose 2 for smaller TV screens with limited split-screen support
# Default: 4
PLAYERS_PER_RACE=4
