# Tolsma 3rd Annual Mario Kart Tournament

# Internal server port (default: 3000). Docker also publishes HTTP port 80.
PORT=3000

# Organizer PIN (CHANGE THIS!)
ORGANIZER_PIN=1234

# Database File Location (optional)
# DB_FILE=./tournament.db

# Phone-reachable origin for the join link and QR code. No trailing path.
# Recommended for Docker, VPNs, or computers with multiple network adapters.
# Use your computer's WiFi address or a working local hostname; never localhost.
# If omitted, direct npm startup uses the first external IPv4 address.
# Docker with the local-name service: PUBLIC_BASE_URL=http://mariokart.local
# PUBLIC_BASE_URL=http://192.168.1.100:3000
